# Forge binds to loopback only; expose it with Tailscale Serve.
ANVIL_HOST=127.0.0.1
ANVIL_PORT=3210
ANVIL_CONFIG=/home/forge/.config/anvil/config.json
ANVIL_DATA_DIR=/home/forge/.local/state/anvil
# Use the live Forge transport while running Vite; defaults to fixtures in development.
# VITE_ANVIL_TRANSPORT=forge
# ANVIL_DEV_FORGE_URL=http://127.0.0.1:3210
# Only for direct loopback development without Tailscale Serve identity headers:
# ANVIL_ALLOW_UNAUTHENTICATED=true

# Optional overrides:
# ANVIL_DATABASE=/home/forge/.local/state/anvil/forge.sqlite
# ANVIL_SESSION_DIR=/home/forge/.local/state/anvil/pi-sessions
# ANVIL_WEB_ROOT=/opt/anvil/apps/web/dist
