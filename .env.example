# Fresh-install Forge listener and paths. Legacy ANVIL_* variables remain accepted as fallbacks.
# On upgrades, do not set a new OCODE_DATA_DIR until legacy state has been safely moved;
# omit it to auto-detect populated legacy state, or point it at that existing directory.
OCODE_HOST=127.0.0.1
OCODE_PORT=3210
OCODE_CONFIG=/home/forge/.config/ocode/config.json
OCODE_DATA_DIR=/home/forge/.local/state/ocode
# Web development transport and proxy target
# VITE_OCODE_TRANSPORT=forge
# OCODE_DEV_FORGE_URL=http://127.0.0.1:3210
# Loopback development only; production requires ownerLogin
# OCODE_ALLOW_UNAUTHENTICATED=true
# Optional explicit paths; defaults derive from OCODE_DATA_DIR
# OCODE_DATABASE=/home/forge/.local/state/ocode/forge.sqlite
# OCODE_SESSION_DIR=/home/forge/.local/state/ocode/pi-sessions
# OCODE_ARTIFACT_DIR=/home/forge/.local/state/ocode/artifacts
# OCODE_TERMINAL_HISTORY_DIR=/home/forge/.local/state/ocode/terminal-history
# OCODE_WEB_ROOT=/opt/ocode/apps/web/dist
# CLI backend URL (ANVIL_URL remains a fallback)
# OCODE_URL=http://127.0.0.1:3210
