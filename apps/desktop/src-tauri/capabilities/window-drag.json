{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-drag",
  "description": "Allows the main macOS window to use native drag regions and title-bar double-click behavior.",
  "windows": ["main"],
  "platforms": ["macOS"],
  "remote": {
    "urls": ["https://*.ts.net/*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
