{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ocode",
  "version": "0.1.0",
  "identifier": "dev.ocode.desktop",
  "build": {
    "frontendDist": "../fallback"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
