{
  "version": 1,
  "toolAliases": [
    {
      "id": "agent.pi-subagent",
      "names": ["subagent"],
      "category": "agent",
      "labels": {
        "queued": "Queueing subagent task",
        "running": "Subagent working",
        "completed": "Subagent finished",
        "failed": "Subagent task failed",
        "cancelled": "Subagent task cancelled"
      },
      "detail": "Delegated task"
    },
    {
      "id": "agent.ocode-subagent",
      "names": ["ocode_subagent"],
      "category": "agent",
      "labels": {
        "queued": "Using subagent",
        "running": "Using subagent",
        "completed": "Used subagent",
        "failed": "Subagent operation failed",
        "cancelled": "Subagent operation cancelled"
      },
      "detail": "Subagent",
      "actions": {
        "spawn": {
          "labels": {
            "queued": "Queueing subagent task",
            "running": "Starting subagent",
            "completed": "Started subagent",
            "failed": "Couldn’t start subagent",
            "cancelled": "Cancelled subagent start"
          },
          "detail": "Delegated task"
        },
        "status": {
          "labels": {
            "queued": "Queueing subagent check",
            "running": "Checking subagent status",
            "completed": "Checked subagent status",
            "failed": "Couldn’t check subagent status",
            "cancelled": "Cancelled subagent check"
          },
          "detail": "Subagent run"
        },
        "cancel": {
          "labels": {
            "queued": "Queueing subagent cancellation",
            "running": "Cancelling subagent run",
            "completed": "Cancelled subagent run",
            "failed": "Couldn’t cancel subagent run",
            "cancelled": "Subagent cancellation stopped"
          },
          "detail": "Subagent run"
        }
      }
    }
  ],
  "shellRules": [
    {
      "id": "deploy.multi-provider-status",
      "executables": ["vercel", "railway"],
      "match": {
        "all": [
          "(?:^|[\\s/])vercel\\s+(?:inspect|ls|list)\\b",
          "(?:^|[\\s/])railway\\s+(?:status|deployment\\s+list)\\b"
        ]
      },
      "category": "shell",
      "labels": {
        "queued": "Queueing deployment checks",
        "running": "Checking deployments",
        "completed": "Checked deployments",
        "failed": "Deployment checks failed",
        "cancelled": "Cancelled deployment checks"
      },
      "detail": "Vercel · Railway"
    },
    {
      "id": "deploy.railway-up",
      "executables": ["railway"],
      "match": { "all": ["(?:^|[\\s/])railway\\s+up\\b"] },
      "category": "shell",
      "labels": {
        "queued": "Queueing Railway deployment",
        "running": "Deploying on Railway",
        "completed": "Started Railway deployment",
        "failed": "Railway deployment failed to start",
        "cancelled": "Cancelled Railway deployment"
      },
      "detail": "Railway · Deployment"
    },
    {
      "id": "deploy.railway-status",
      "executables": ["railway"],
      "match": { "all": ["(?:^|[\\s/])railway\\s+(?:status|deployment\\s+list)\\b"] },
      "category": "shell",
      "labels": {
        "queued": "Queueing Railway deployment check",
