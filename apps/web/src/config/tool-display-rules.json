        "completed": "Checked Railway deployment",
        "failed": "Railway deployment check failed",
        "cancelled": "Cancelled Railway deployment check"
      },
      "detail": "Railway · Deployment"
    },
    {
      "id": "deploy.vercel-inspect",
      "executables": ["vercel"],
      "match": { "all": ["(?:^|[\\s/])vercel\\s+inspect\\b"] },
      "category": "shell",
      "labels": {
        "queued": "Waiting to check Vercel deployment",
        "running": "Waiting for Vercel deployment",
        "completed": "Checked Vercel deployment",
        "failed": "Vercel deployment check failed",
        "cancelled": "Cancelled Vercel deployment check"
      },
      "detail": "Vercel · Deployment"
    },
    {
      "id": "deploy.vercel-list",
      "executables": ["vercel"],
      "match": { "all": ["(?:^|[\\s/])vercel\\s+(?:ls|list)\\b"] },
      "category": "shell",
      "labels": {
        "queued": "Queueing deployment check",
        "running": "Checking Vercel deployments",
        "completed": "Checked Vercel deployments",
        "failed": "Couldn’t check Vercel deployments",
        "cancelled": "Cancelled deployment check"
      },
      "detail": "Vercel · Deployments"
    },
    {
      "id": "build.types-and-app",
      "executables": ["pnpm", "npm", "yarn", "bun"],
      "match": {
        "all": [
          "^(?:pnpm(?:\\s+(?:exec|run))?|npm(?:\\s+(?:exec|run))?|yarn(?:\\s+run)?|bun(?:\\s+run)?)\\s+(?:tsc|typecheck)\\b",
          "^(?:pnpm|npm|yarn|bun)(?:\\s+run)?\\s+build\\b"
        ]
      },
      "category": "shell",
      "labels": {
        "queued": "Queueing typecheck and build",
        "running": "Checking types and building the app",
        "completed": "Checked types and built the app",
        "failed": "Typecheck or build failed",
        "cancelled": "Cancelled typecheck and build"
      },
      "detail": "TypeScript · Production build"
    },
    {
      "id": "git.stage",
      "executables": ["git"],
      "match": {
        "all": ["(?:^|[;&|]\\s*)git\\s+add\\b"],
        "none": ["(?:^|[;&|]\\s*)git\\s+(?:commit|push)\\b"]
      },
      "category": "git",
      "labels": {
        "queued": "Queueing {fileCountLabel} to stage",
        "running": "Staging {fileCountLabel}",
        "completed": "Staged {fileCountLabel}",
        "failed": "Couldn’t stage {fileCountLabel}",
        "cancelled": "Cancelled staging changes"
      },
      "detail": "Git · {fileCountLabel}"
    },
    {
      "id": "git.commit",
      "executables": ["git"],
      "match": {
        "all": ["(?:^|[;&|]\\s*)git\\s+commit\\b"],
        "none": ["(?:^|[;&|]\\s*)git\\s+push\\b"]
      },
      "category": "git",
      "labels": {
        "queued": "Queueing commit",
        "running": "Creating commit",
        "completed": "Created commit",
        "failed": "Couldn’t create commit",
        "cancelled": "Cancelled commit"
