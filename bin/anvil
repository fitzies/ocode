#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SERVICE="anvil-forge"
ANVIL_URL="${ANVIL_URL:-http://127.0.0.1:3210}"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[32m'; RED=$'\033[31m'; RESET=$'\033[0m'
else
  BOLD=""; DIM=""; GREEN=""; RED=""; RESET=""
fi

usage() {
  cat <<EOF
${BOLD}anvil${RESET} — manage the Anvil service

${BOLD}Usage:${RESET} anvil <command>

  start      Start Anvil and enable Tailscale Serve
  stop       Stop Anvil and disable Tailscale Serve
  restart    Rebuild and restart Anvil
  rebuild    Rebuild without restarting
  status     Show Anvil, Tailscale, and every Pi process
  logs       Follow Anvil service logs
  help       Show this help
EOF
}

heading() { printf "\n%s%s%s\n" "$BOLD" "$1" "$RESET"; }

build() {
  echo "Building Anvil…"
  (cd "$REPO_ROOT" && corepack pnpm build)
}

enable_serve() {
  echo "Enabling Tailscale Serve…"
  sudo tailscale serve --bg "$ANVIL_URL"
}

start() {
  echo "Starting Anvil…"
  sudo systemctl start "$SERVICE"
  enable_serve
  echo "${GREEN}Anvil is running.${RESET}"
}

stop() {
  echo "Stopping Anvil…"
  sudo systemctl stop "$SERVICE"
  echo "Disabling Tailscale Serve…"
  sudo tailscale serve --https=443 off
  echo "Anvil stopped."
}

restart() {
  build
  echo "Restarting Anvil…"
  sudo systemctl restart "$SERVICE"
  enable_serve
  echo "${GREEN}Anvil was rebuilt and restarted.${RESET}"
}

show_pi_processes() {
  local rows
  rows="$(ps -eo pid=,ppid=,user=,etime=,stat=,args= | awk '
    {
      command = $0
      if (command ~ /(^|[[:space:]\/])pi([[:space:]]|$)/ && command !~ /awk /) print
    }')"

  heading "Pi instances"
  if [[ -z "$rows" ]]; then
    echo "${DIM}No Pi processes running.${RESET}"
    return
  fi
  printf "%-8s %-8s %-12s %-12s %-6s %s\n" "PID" "PPID" "USER" "UPTIME" "STATE" "COMMAND"
  echo "$rows" | awk '{
    pid=$1; ppid=$2; user=$3; elapsed=$4; state=$5
    $1=$2=$3=$4=$5=""; sub(/^[[:space:]]+/, "")
    printf "%-8s %-8s %-12s %-12s %-6s %s\n", pid, ppid, user, elapsed, state, $0
  }'
}

status() {
  local failed=0 state health

  heading "Anvil"
  state="$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
  if [[ "$state" == "active" ]]; then
    printf "Service     %s● running%s\n" "$GREEN" "$RESET"
  else
    printf "Service     %s● %s%s\n" "$RED" "${state:-unknown}" "$RESET"
    failed=1
  fi

  if health="$(curl --silent --show-error --fail --max-time 3 "$ANVIL_URL/api/v1/health/ready" 2>/dev/null)"; then
    printf "Health      %s● ready%s  %s\n" "$GREEN" "$RESET" "$health"
  else
    printf "Health      %s● unavailable%s  %s\n" "$RED" "$RESET" "$ANVIL_URL"
    failed=1
  fi

  heading "Tailscale Serve"
  tailscale serve status 2>/dev/null || echo "${DIM}Unavailable.${RESET}"

  show_pi_processes
  return "$failed"
}

logs() {
  exec sudo journalctl -u "$SERVICE" -f --no-pager
}

case "${1:-help}" in
  start) start ;;
  stop|end) stop ;;
  restart) restart ;;
  rebuild) build ;;
  status) status ;;
  logs) logs ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
