#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SERVICE="anvil-forge"
FORGE_URL="http://127.0.0.1:3210"

usage() {
  cat <<'EOF'
Usage: forge <command>

Commands:
  start     Start Anvil Forge and expose it with Tailscale Serve
  stop      Stop Anvil Forge and disable Tailscale Serve
  end       Alias for stop
  restart   Rebuild Anvil, restart Forge, and ensure Tailscale Serve is active
  rebuild   Rebuild Anvil without restarting Forge
  status    Show Forge, Tailscale Serve, and health status
  help      Show this help
EOF
}

build() {
  echo "Building Anvil..."
  (cd "$REPO_ROOT" && corepack pnpm build)
}

enable_serve() {
  echo "Enabling Tailscale Serve..."
  sudo tailscale serve --bg "$FORGE_URL"
}

start() {
  echo "Starting $SERVICE..."
  sudo systemctl start "$SERVICE"
  enable_serve
  echo "Forge started."
  tailscale serve status
}

stop() {
  echo "Stopping $SERVICE..."
  sudo systemctl stop "$SERVICE"
  echo "Disabling Tailscale Serve..."
  sudo tailscale serve --https=443 off
  echo "Forge stopped."
}

restart() {
  build
  echo "Restarting $SERVICE..."
  sudo systemctl restart "$SERVICE"
  enable_serve
  echo "Forge rebuilt and restarted."
  tailscale serve status
}

status() {
  systemctl status "$SERVICE" --no-pager || true
  echo
  tailscale serve status || true
  echo
  if curl --silent --show-error --fail --max-time 3 "$FORGE_URL/api/v1/health/ready"; then
    echo
  else
    echo "Forge health check failed." >&2
    return 1
  fi
}

case "${1:-help}" in
  start) start ;;
  stop|end) stop ;;
  restart) restart ;;
  rebuild) build ;;
  status) status ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
